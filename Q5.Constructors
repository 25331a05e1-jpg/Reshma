#include<iostream>
#include<string>
using namespace std;
class student{
    private:
    string name;
    int age;
    public:
    student(){
        cout<<"constructor called"<<endl;
        name="reshma";
        age=18;
    }
    public:
    void display(){
        cout<<"name="<<name<<endl<<"age="<<age<<endl;
    }
};
int main(){
    student s;
    s.display();
	cout<<"25331A05E1"<<endl;
  return 0;
}
